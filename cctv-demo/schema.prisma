datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  INSPECTOR
  PROJECT_INCHARGE
  STAFF
  BENEFICIARY
  ADMIN
}

enum CameraStatus {
  ONLINE
  OFFLINE
  ERROR
  DISABLED
}

enum CallStatus {
  REQUESTED
  RINGING
  ACCEPTED
  CONNECTED
  REJECTED
  MISSED
  ENDED
  FAILED
}

enum VerificationResult {
  PENDING
  VERIFIED
  NOT_VERIFIED
}

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  role             Role
  projectId        String?
  project          Project?           @relation(fields: [projectId], references: [id])
  isAvailable      Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  callsInitiated   VideoCallSession[] @relation("CallInitiator")
  callsReceived    VideoCallSession[] @relation("CallParticipant")
}

model Project {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  location    String
  description String?
  cameras     Camera[]
  users       User[]
  inspections Inspection[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Camera {
  id           String       @id @default(uuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  location     String
  rtspUrl      String       // Credential-masked in public responses
  streamKey    String       @unique // Key on media server, e.g. "camera-1"
  protocol     String       @default("RTSP")
  status       CameraStatus @default(OFFLINE)
  healthStatus String       @default("HEALTHY") // HEALTHY, WARNING, UNREACHABLE
  lastSeen     DateTime?
  lastError    String?
  enabled      Boolean      @default(true)
  alerts       CctvAlert[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model CctvAlert {
  id        String   @id @default(uuid())
  cameraId  String
  camera    Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  eventType String   // CAMERA_OFFLINE, CAMERA_RESTORED, STREAM_FAILURE, AI_ALERT
  severity  String   // INFO, WARNING, CRITICAL
  message   String
  metadata  String?  // JSON formatted extra details
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Inspection {
  id          String             @id @default(uuid())
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id])
  inspectorId String
  status      String             @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  sessions    VideoCallSession[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model VideoCallSession {
  id                    String             @id @default(uuid())
  inspectionId          String
  inspection            Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  initiatedById         String
  initiatedBy           User               @relation("CallInitiator", fields: [initiatedById], references: [id])
  selectedParticipantId String
  selectedParticipant   User               @relation("CallParticipant", fields: [selectedParticipantId], references: [id])
  participantRole       Role
  roomId                String             @unique
  status                CallStatus         @default(REQUESTED)
  result                VerificationResult @default(PENDING)
  notes                 String?
  startedAt             DateTime           @default(now())
  connectedAt           DateTime?
  endedAt               DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}
