# Environment Configuration Template for DoSJE Monitoring Backend
# Copy this file to .env and configure your local settings.
# NEVER commit the actual .env file or real secrets to version control.

# Server Port (Default: 5000)
PORT=5000

# PostgreSQL Connection String via pg adapter
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/dosje_monitoring

# JWT Secret for signing authentication tokens
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# CORS Allowed Origins (comma-separated for multiple, or * for all in dev)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:19006
