# ==============================================================================
# SIH 2026 - DoSJE Drishti Monitoring Platform
# Unified Environment Configuration Template
# DO NOT COMMIT REAL PASSWORDS, TOKENS, OR SECRETS TO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Central Backend (Node.js / Express / Prisma TypeScript)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
# For Production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/dosje_drishti?schema=public"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
AI_SHARED_SECRET=replace_with_a_secure_ai_shared_webhook_secret
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. AI Subsystem (Python / FastAPI / YOLOv8)
# ------------------------------------------------------------------------------
AI_CONFIG_VERSION=cfg-2026.1
AI_MODEL_VERSION=v1.0.0
AI_HOST=0.0.0.0
AI_PORT=8000
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_DEVICE=cpu
TARGET_CLASSES=["person"]
DEFAULT_LOITERING_THRESHOLD_SEC=30.0
ANOMALY_COOLDOWN_SEC=10.0
INCIDENT_CORRELATION_WINDOW_SEC=60.0
EVIDENCE_STORAGE_DIR=data/evidence
EVIDENCE_JPEG_QUALITY=92

# ------------------------------------------------------------------------------
# 3. Admin Web Dashboard (Vite / React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api
VITE_USE_MOCK_DATA=false

# ------------------------------------------------------------------------------
# 4. CCTV & WebRTC Streaming (MediaMTX / CoTURN)
# ------------------------------------------------------------------------------
MEDIA_SERVER_HOST=localhost
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

